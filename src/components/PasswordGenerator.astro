---
import { DEFAULT_PASSWORD_PREFERENCES } from '@/lib/password/preferences';
---

<section class="generator-card reveal delay-1" data-password-generator>
  <div class="generator-card__panel">
    <div class="field field--output">
      <label class="field__label" for="generated-password">Generated password</label>
      <input
        id="generated-password"
        class="field__control field__control--output"
        type="text"
        value=""
        readonly
        autocomplete="off"
        spellcheck="false"
        placeholder="Your password appears here"
        data-password-output
      />
    </div>

    <div class="generator-card__actions">
      <button class="button button--primary" type="button" data-generate-password>
        <svg class="button__icon" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
        <span>Generate password</span>
      </button>
      <button class="button button--copy" type="button" data-copy-password disabled aria-label="Copy password">
        <svg class="button__icon button__icon--copy" aria-hidden="true" viewBox="0 0 24 24">
          <rect x="8" y="8" width="14" height="14" rx="2" ry="2" />
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
        </svg>
        <svg class="button__icon button__icon--check" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span class="button__label" data-copy-label>Copy password</span>
      </button>
    </div>

    <div class="field">
      <div class="field__row">
        <label class="field__label" for="password-length">Password length</label>
        <output class="field__output" for="password-length" data-password-length-output>
          {DEFAULT_PASSWORD_PREFERENCES.passwordLength}
        </output>
      </div>
      <input
        id="password-length"
        class="range"
        type="range"
        min="4"
        max="50"
        value={DEFAULT_PASSWORD_PREFERENCES.passwordLength}
        data-password-length
      />
    </div>

    <fieldset class="fieldset">
      <legend class="field__label">Character types</legend>
      <div class="checks">
        <label class="check">
          <input type="checkbox" checked data-password-field="uppercase" />
          <span>Uppercase letters</span>
        </label>
        <label class="check">
          <input type="checkbox" checked data-password-field="lowercase" />
          <span>Lowercase letters</span>
        </label>
        <label class="check">
          <input type="checkbox" checked data-password-field="numbers" />
          <span>Numbers</span>
        </label>
        <label class="check">
          <input type="checkbox" checked data-password-field="symbols" />
          <span>Symbols</span>
        </label>
      </div>
    </fieldset>

    <p class="status" aria-live="polite" data-password-status></p>
  </div>
</section>

<style>
  .generator-card {
    width: min(100%, 58rem);
    margin-inline: auto;
  }

  .generator-card__panel {
    padding: clamp(1rem, 3vw, 2rem);
    display: grid;
    gap: 1.25rem;
    border: 0;
    border-radius: 1.5rem;
    background: var(--surface);
    box-shadow: none;
    backdrop-filter: blur(18px);
    animation: fade-up 700ms ease-out 240ms both;
  }

  .field,
  .fieldset {
    display: grid;
    gap: 0.75rem;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .field__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .field__label {
    font-weight: 700;
  }

  .field__output,
  .status {
    color: var(--muted-text);
  }

  .field__control,
  .range {
    width: 100%;
  }

  .field__control {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface-strong);
    color: var(--foreground);
    padding: 1rem 1.1rem;
  }

  .field__control--output {
    font-size: clamp(1rem, 2vw, 1.1rem);
    letter-spacing: 0.02em;
  }

  .generator-card__actions {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .button {
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    background: var(--surface-strong);
    color: var(--foreground);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.1rem;
    padding: 0.8rem 1rem;
    font-weight: 700;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .button:hover:not(:disabled) {
    transform: translateY(-1px);
    background: color-mix(in oklab, var(--surface-strong) 88%, black);
    border-color: color-mix(in oklab, var(--foreground) 18%, var(--border));
  }

  .button__icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .button--primary {
    background: var(--primary);
    border-color: color-mix(in oklab, var(--primary) 30%, var(--border));
    color: var(--primary-foreground);
  }

  .button--primary:hover:not(:disabled) {
    background: var(--primary-hover);
    border-color: color-mix(in oklab, var(--primary-hover) 55%, black);
  }

  .button--copy[data-copied='true'] .button__icon--copy,
  .button--copy[data-copied='false'] .button__icon--check {
    display: none;
  }

  .button--copy[data-copied='true'] .button__icon--check,
  .button--copy[data-copied='false'] .button__icon--copy {
    display: block;
  }

  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .checks {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
    margin-top: 0.35rem;
  }

  .check {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.95rem;
    background: color-mix(in oklab, var(--surface-strong) 70%, transparent);
  }

  .check input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--primary);
  }

  .range {
    appearance: none;
    height: 0.42rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--foreground) 12%, transparent);
  }

  .range::-webkit-slider-thumb {
    appearance: none;
    width: 1.1rem;
    height: 1.1rem;
    border: 0;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 0.25rem color-mix(in oklab, var(--primary) 18%, transparent);
  }

  .range::-moz-range-thumb {
    width: 1.1rem;
    height: 1.1rem;
    border: 0;
    border-radius: 50%;
    background: var(--primary);
  }

  .status {
    margin: 0;
    min-height: 1.25rem;
    font-size: 0.95rem;
  }

  .status[data-tone='success'] {
    color: color-mix(in oklab, var(--primary) 80%, white);
  }

  .status[data-tone='error'] {
    color: #ef4444;
  }

  .status--ghost {
    opacity: 0.8;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .generator-card__actions {
      grid-template-columns: 1fr;
    }
  }
</style>
