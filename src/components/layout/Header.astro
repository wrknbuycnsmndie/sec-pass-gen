---
import ThemeSwitch from '@/components/shared/ThemeSwitch.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <span class="header-spacer" aria-hidden="true"></span>
    <a class="brand" href="/" aria-label="SecPassGen home">SecPassGen</a>
    <div class="header-actions">
      <ThemeSwitch />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(18px);
    background: color-mix(in oklab, var(--surface) 84%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    min-height: 4.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .header-spacer {
    width: 100%;
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    margin-right: 0.5rem;
  }

  @media (min-width: 768px) {
    .header-actions {
      margin-right: 1.5rem;
    }
  }

  .brand {
    justify-self: center;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--primary);
  }
</style>
